PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/instagram
JWT_SECRET=change_this_to_a_long_random_string_32_chars_or_more
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# --- Email (needed for signup codes + password reset) ---
# Leave SMTP_HOST empty in development: codes/links are printed in this terminal.
# Gmail example: create an App Password at https://myaccount.google.com/apppasswords (2-step verification must be ON)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Instagram <yourname@gmail.com>"

# Development helper: show the code / reset link on screen too (ignored when NODE_ENV=production)
DEV_SHOW_OTP=true
# Keep false normally; true only for automated tests
RATE_LIMIT_DISABLED=false
