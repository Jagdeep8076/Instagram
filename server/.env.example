# Instaclone Server Environment Configuration

# Server Port
PORT=5000

# Application Environment (development | production)
NODE_ENV=development

# Allowed Client URL for Strict CORS & Cookie Sharing
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas URI or Local MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/instaclone

# JSON Web Token Secret for short-lived access tokens (15 minutes)
JWT_SECRET=your_long_random_jwt_access_secret_key_minimum_32_characters

# JSON Web Token Secret for long-lived refresh tokens (30 days)
JWT_REFRESH_SECRET=your_long_random_jwt_refresh_secret_key_minimum_32_characters

# Nodemailer SMTP Configuration for Email Verification & Password Recovery
# In local development without SMTP, codes and links will log directly to server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="Instaclone Support" <no-reply@instaclone.com>
